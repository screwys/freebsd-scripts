+// OpenPAM's return codes and credential flags differ from Linux-PAM.
+extern crate pam_sys as sys;
+
+use libc::{c_char, c_int};
+use std::ffi::CString;
+
+pub use self::sys::{
+    raw, PamConversation, PamHandle, PamItemType, PamMessage, PamMessageStyle, PamResponse,
+};
+
+#[allow(non_camel_case_types, dead_code)]
+#[derive(Clone, Copy, Debug, PartialEq)]
+#[repr(i32)]
+pub enum PamReturnCode {
+    SUCCESS = 0,
+    OPEN_ERR = 1,
+    SYMBOL_ERR = 2,
+    SERVICE_ERR = 3,
+    SYSTEM_ERR = 4,
+    BUF_ERR = 5,
+    CONV_ERR = 6,
+    PERM_DENIED = 7,
+    MAXTRIES = 8,
+    AUTH_ERR = 9,
+    NEW_AUTHTOK_REQD = 10,
+    CRED_INSUFFICIENT = 11,
+    AUTHINFO_UNAVAIL = 12,
+    USER_UNKNOWN = 13,
+    CRED_UNAVAIL = 14,
+    CRED_EXPIRED = 15,
+    CRED_ERR = 16,
+    ACCT_EXPIRED = 17,
+    AUTHTOK_EXPIRED = 18,
+    SESSION_ERR = 19,
+    AUTHTOK_ERR = 20,
+    AUTHTOK_RECOVERY_ERR = 21,
+    AUTHTOK_LOCK_BUSY = 22,
+    AUTHTOK_DISABLE_AGING = 23,
+    NO_MODULE_DATA = 24,
+    IGNORE = 25,
+    ABORT = 26,
+    TRY_AGAIN = 27,
+    MODULE_UNKNOWN = 28,
+    DOMAIN_UNKNOWN = 29,
+    BAD_HANDLE = 30,
+    BAD_ITEM = 31,
+    BAD_FEATURE = 32,
+    BAD_CONSTANT = 33,
+}
+
+impl From<c_int> for PamReturnCode {
+    fn from(code: c_int) -> Self {
+        match code {
+            0 => Self::SUCCESS,
+            1 => Self::OPEN_ERR,
+            2 => Self::SYMBOL_ERR,
+            3 => Self::SERVICE_ERR,
+            4 => Self::SYSTEM_ERR,
+            5 => Self::BUF_ERR,
+            6 => Self::CONV_ERR,
+            7 => Self::PERM_DENIED,
+            8 => Self::MAXTRIES,
+            9 => Self::AUTH_ERR,
+            10 => Self::NEW_AUTHTOK_REQD,
+            11 => Self::CRED_INSUFFICIENT,
+            12 => Self::AUTHINFO_UNAVAIL,
+            13 => Self::USER_UNKNOWN,
+            14 => Self::CRED_UNAVAIL,
+            15 => Self::CRED_EXPIRED,
+            16 => Self::CRED_ERR,
+            17 => Self::ACCT_EXPIRED,
+            18 => Self::AUTHTOK_EXPIRED,
+            19 => Self::SESSION_ERR,
+            20 => Self::AUTHTOK_ERR,
+            21 => Self::AUTHTOK_RECOVERY_ERR,
+            22 => Self::AUTHTOK_LOCK_BUSY,
+            23 => Self::AUTHTOK_DISABLE_AGING,
+            24 => Self::NO_MODULE_DATA,
+            25 => Self::IGNORE,
+            26 => Self::ABORT,
+            27 => Self::TRY_AGAIN,
+            28 => Self::MODULE_UNKNOWN,
+            29 => Self::DOMAIN_UNKNOWN,
+            30 => Self::BAD_HANDLE,
+            31 => Self::BAD_ITEM,
+            32 => Self::BAD_FEATURE,
+            33 => Self::BAD_CONSTANT,
+            _ => Self::SYSTEM_ERR,
+        }
+    }
+}
+
+#[allow(non_camel_case_types)]
+#[derive(Clone, Copy)]
+#[repr(i32)]
+pub enum PamFlag {
+    NONE = 0,
+    ESTABLISH_CRED = 1,
+    DELETE_CRED = 2,
+    CHANGE_EXPIRED_AUTHTOK = 4,
+}
+
+pub fn start(
+    service: &str,
+    user: Option<&str>,
+    conv: &PamConversation,
+    handle: *mut *mut PamHandle,
+) -> PamReturnCode {
+    let service = match CString::new(service) {
+        Ok(value) => value,
+        Err(_) => return PamReturnCode::SERVICE_ERR,
+    };
+    let user = match user.map(CString::new).transpose() {
+        Ok(value) => value,
+        Err(_) => return PamReturnCode::BUF_ERR,
+    };
+    unsafe {
+        raw::pam_start(
+            service.as_ptr(),
+            user.as_ref().map_or(std::ptr::null(), |u| u.as_ptr()),
+            conv,
+            handle.cast(),
+        )
+        .into()
+    }
+}
+
+macro_rules! pam_call {
+    ($name:ident, $raw:ident) => {
+        pub fn $name(handle: &mut PamHandle, flags: PamFlag) -> PamReturnCode {
+            unsafe { raw::$raw(handle, flags as c_int).into() }
+        }
+    };
+}
+
+pam_call!(authenticate, pam_authenticate);
+pam_call!(acct_mgmt, pam_acct_mgmt);
+pam_call!(chauthtok, pam_chauthtok);
+pam_call!(setcred, pam_setcred);
+pam_call!(open_session, pam_open_session);
+pam_call!(close_session, pam_close_session);
+
+pub fn end(handle: &mut PamHandle, code: PamReturnCode) -> PamReturnCode {
+    unsafe { raw::pam_end(handle, code as c_int).into() }
+}
+
+pub fn putenv(handle: &mut PamHandle, value: &str) -> PamReturnCode {
+    match CString::new(value) {
+        Ok(value) => unsafe { raw::pam_putenv(handle, value.as_ptr()).into() },
+        Err(_) => PamReturnCode::BUF_ERR,
+    }
+}
+
+pub fn get_user(
+    handle: &mut PamHandle,
+    user: *mut *const c_char,
+    prompt: *const c_char,
+) -> PamReturnCode {
+    unsafe { raw::pam_get_user(handle, user, prompt).into() }
+}
+
+pub fn getenvlist(handle: &mut PamHandle) -> *const *const c_char {
+    unsafe { raw::pam_getenvlist(handle) }
+}
diff --git a/greetd/src/session/freebsd.rs b/greetd/src/session/freebsd.rs
new file mode 100644
index 0000000..61b9050
--- /dev/null
+++ b/greetd/src/session/freebsd.rs
@@ -0,0 +1,59 @@
+use crate::error::Error;
+use libc::{c_uint, c_void, passwd, uid_t};
+use nix::errno::Errno;
+use std::{
+    env,
+    ffi::{CStr, CString},
+    os::unix::ffi::OsStrExt,
+};
+
+#[link(name = "util")]
+extern "C" {
+    fn setusercontext(
+        lc: *mut c_void,
+        pwd: *const passwd,
+        uid: uid_t,
+        flags: c_uint,
+    ) -> libc::c_int;
+}
+
+pub fn set_user_context(name: &CStr, uid: uid_t, pam_env: &[&CStr]) -> Result<Vec<CString>, Error> {
+    let pwd = unsafe { libc::getpwnam(name.as_ptr()) };
+    if pwd.is_null() {
+        return Err("unable to get user info for login context".into());
+    }
+    // Start with PAM's environment, then apply the user's login.conf settings.
+    for (key, _) in env::vars_os() {
+        env::remove_var(key);
+    }
+    for entry in pam_env {
+        let bytes = entry.to_bytes();
+        if let Some(separator) = bytes.iter().position(|byte| *byte == b'=') {
+            env::set_var(
+                std::ffi::OsStr::from_bytes(&bytes[..separator]),
+                std::ffi::OsStr::from_bytes(&bytes[separator + 1..]),
+            );
+        }
+    }
+    // Groups were set before pam_setcred so PAM can add supplementary groups.
+    const LOGIN_SETALL: c_uint = 0x07ff;
+    const LOGIN_SETGROUP: c_uint = 0x0001;
+    Errno::result(unsafe {
+        setusercontext(
+            std::ptr::null_mut(),
+            pwd,
+            uid,
+            LOGIN_SETALL & !LOGIN_SETGROUP,
+        )
+    })
+    .map(drop)
+    .map_err(|e| Error::Error(format!("unable to set login context: {e}")))?;
+    env::vars_os()
+        .map(|(key, value)| {
+            let mut entry = key.as_bytes().to_vec();
+            entry.push(b'=');
+            entry.extend_from_slice(value.as_bytes());
+            CString::new(entry).map_err(|e| Error::Error(e.to_string()))
+        })
+        .collect()
+}
