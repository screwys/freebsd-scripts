+use nix::{ioctl_read_bad, ioctl_write_int_bad, ioctl_write_ptr_bad};
+
+pub const KDTEXT: i32 = 0;
+pub const KDGRAPHICS: i32 = 1;
+pub const VT_AUTO: u8 = 0;
+
+// sys/consio.h uses _IOWINT for integer arguments and _IOR for results.
+ioctl_write_int_bad!(kd_setmode, 0x20044b0a);
+ioctl_write_int_bad!(vt_activate, 0x20047605);
+ioctl_write_int_bad!(vt_waitactive, 0x20047606);
+ioctl_write_ptr_bad!(vt_setmode, 0x80087602, vt_mode);
+ioctl_read_bad!(vt_openqry, 0x40047601, libc::c_int);
+ioctl_read_bad!(vt_getactive, 0x40047607, libc::c_int);
+ioctl_write_int_bad!(term_tiocsctty, libc::TIOCSCTTY);
+
+#[repr(C)]
+pub struct vt_mode {
+    pub mode: u8,
+    pub waitv: u8,
+    pub relsig: u16,
+    pub acqsig: u16,
+    pub frsig: u16,
+}
