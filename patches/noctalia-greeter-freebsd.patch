diff --git a/src/core/executable_path.h b/src/core/executable_path.h
new file mode 100644
index 0000000..f867158
--- /dev/null
+++ b/src/core/executable_path.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <cerrno>
+#include <cstddef>
+#include <unistd.h>
+
+#if defined(__FreeBSD__)
+#include <sys/types.h>
+#include <sys/sysctl.h>
+#endif
+
+namespace paths {
+
+  inline ssize_t readExecutablePath(char* buffer, std::size_t capacity) {
+#if defined(__FreeBSD__)
+    int mib[] = {CTL_KERN, KERN_PROC, KERN_PROC_PATHNAME, -1};
+    std::size_t size = capacity;
+    if (::sysctl(mib, 4, buffer, &size, nullptr, 0) != 0) {
+      return -1;
+    }
+    if (size <= 1 || buffer[0] == '\0') {
+      errno = ENOENT;
+      return -1;
+    }
+    return static_cast<ssize_t>(size - 1);
+#else
+    return ::readlink("/proc/self/exe", buffer, capacity);
+#endif
+  }
+
+} // namespace paths
